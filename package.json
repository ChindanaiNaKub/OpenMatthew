{
  "name": "opencode-matthew-auth",
  "version": "0.2.0",
  "description": "Use your CMU Matthew AI account from any OpenAI-compatible agent platform, or as an OpenCode plugin",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "Chindanai Jaiman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChindanaiNaKub/OpenMatthew.git"
  },
  "homepage": "https://github.com/ChindanaiNaKub/OpenMatthew#readme",
  "bugs": {
    "url": "https://github.com/ChindanaiNaKub/OpenMatthew/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "openmatthew-serve": "./dist/src/server/bin.js",
    "openmatthew-creds": "./dist/src/server/creds.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "serve": "npm run build && node dist/src/server/bin.js",
    "creds": "npm run build && node dist/src/server/creds.js",
    "prepublishOnly": "npm run build",
    "check-api": "node scripts/check-api.mjs"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^0.15.30"
  },
  "keywords": [
    "matthew",
    "cmu",
    "chiang-mai-university",
    "openai-compatible",
    "opencode",
    "llm",
    "proxy",
    "agent"
  ]
}
